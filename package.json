{
    "name": "@nuvo-js/core",
    "version": "1.0.9",
    "description": "A lightweight custom DOM rendering engine",
    "keywords": [
        "nuvo",
        "dom",
        "renderer",
        "rendering-engine",
        "typescript",
        "javascript"
    ],
    "homepage": "https://github.com/Gagik-arch/nuvo-js#readme",
    "bugs": {
        "url": "https://github.com/Gagik-arch/nuvo-js/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Gagik-arch/nuvo-js.git"
    },
    "license": "ISC",
    "author": "Gagik Chilingaryan",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./types": {
            "types": "./dist/types.d.ts"
        }
    },
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^3.2.4",
        "jsdom": "^26.1.0",
        "typescript": "^7.0.2",
        "vitest": "^3.2.7"
    }
}
